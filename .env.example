# Salin menjadi .env lalu ganti nilainya. File .env TIDAK ikut ke git.
# jalankan-demo.ps1 membuat .env berisi nilai acak otomatis bila file ini belum ada.
# Jangan pakai tanda : atau , di password.
NETRA_USERS=operator:GANTI_PASSWORD_OPERATOR:operator,komandan:GANTI_PASSWORD_KOMANDAN:komandan
NETRA_INGEST_KEY=GANTI_KUNCI_INGEST_ACAK

# Opsional
# NETRA_TILE_URL=http://IP-server-tile/tile/{z}/{x}/{y}.png
# UNSPLASH_ACCESS_KEY=
